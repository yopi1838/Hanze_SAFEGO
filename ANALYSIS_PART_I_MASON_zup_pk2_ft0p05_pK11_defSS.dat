; =====================================================================
; ANALYSIS_PART_I_MASON_zup_pk2_ft0p05_pK11_defSS.dat -- the pK11 pocket build with DEFORMABLE masonry blocks, in
;   SMALL STRAIN, built FROM THE GEOMETRY (6 Nov 2026, v2): no restore of GEO_WALL_zup_pk2 or of any rigid save.
;   1. GEOMETRY: the commands of Geo_Prep_zup_pk2.dat, unchanged (Groningen_zup.dec, support, top beam, the Y = 0.105
;      cuts of the pocket bands, pocket voids, group 'Masonry'), without its save.
;   2. ZONING straight after the geometry: EVERY block except 'S' and 'T_B' (by exclusion; v3) -> elastic tetrahedral
;      zones, edge ZONE_EDGE, E_UNIT / NU_UNIT; a check stops the build if any wall block is left unzoned (rigid);
;      density 1885 kg/m3. Joists, joist supports, base 'S' and top beam 'T_B' stay RIGID (spring force on T_B as before).
;   3. BUILD: ANALYSIS_PART_I_MASON_zup_pk2_ft0p05.dat from the joists on, with
;        large strain OFF throughout (mat_case.dat's properties copied inline, without its 'model large-strain on');
;        the pK11 pocket set on the joist-masonry contacts (ks 1.1e8 Pa/m, cohesion 0.1 MPa, friction 31 deg, tension 0).
;   NOT CHANGED: the joint set (kn = ks = 2.5e9 Pa/m, f_t 0.05 MPa, c 0.2 MPa, 36 deg, MASON v12). kn lumps the units'
;     deformability (kn x course height ~ 146 MPa against E_UNIT of a few GPa), so the units add only ~3 % flexibility.
;   E_UNIT: PLACEHOLDER 5 GPa, nu 0.15 -- replace with the characterisation's unit modulus if available.
;   Output: Part_I_MASON_v8_SmallStrain_springforce_zup_pk2_ft0p05_pK11_def.sav   (FISH 'tension' = 0.05e6)
; =====================================================================
model new
model config dynamic
model dynamic active off
model large-strain off

call 'Groningen_zup.dec'

;SUPPORT BLOCK
block create brick 0 1.292 0.0 0.210 -0.05 0 group 'S'

;TOP BEAM
block create brick 0 1.292 0.0 0.210 2.58 2.68 group 'T_B'

; ---- split at Y = 0.105 as Geo_Prep.dat does it -------------------------------------------------------------
; stretcher course of each pocket band (course 5, Z 0.2932-0.3518; course 37, Z 2.1697-2.2283): two leaves across
; the whole wall -- a stretcher course of the one-brick wall is two rows of stretchers (Groningen.dec merges them)
block hide
block hide off range pos-z 0.30 0.34
block hide off range pos-z 2.18 2.22
block cut joint-set dip 90 dip-direction 0 origin 0 0.105 0

; header courses of each pocket band (4, 6, 36, 38): headers run through the thickness, so only the brick over
; each pocket is split (as Geo_Prep.dat's second cut)
block hide
block hide off range pos-z 0.24 0.29
block hide off range pos-z 0.36 0.40
block hide off range pos-z 2.12 2.16
block hide off range pos-z 2.24 2.28
block hide range pos-x -1 0.33
block hide range pos-x 0.42 0.86
block hide range pos-x 0.97 11
block cut joint-set dip 90 dip-direction 0 origin 0 0.105 0

; ---- remove the pocket volume: bands, joist half (Y > 0.105), between the pocket faces -------------------------
block hide off

block hide range pos-z -10000 0.2346
block hide range pos-z 0.4105 2.1109
block hide range pos-z 2.2869 100000

block hide range pos-y -1 0.105

block cut joint-set dip 90 dip-direction 90 origin 0.9690 0 0
block cut joint-set dip 90 dip-direction 90 origin 0.8882 0 0
block delete range pos-x 0.8882 0.9690

block cut joint-set dip 90 dip-direction 90 origin 0.4037 0 0
block cut joint-set dip 90 dip-direction 90 origin 0.3230 0 0
block delete range pos-x 0.3230 0.4037

block hide off
block group "Masonry" range group "S" or "T_B" not

; ---- zoning, straight after the geometry (v3) --------------------------------------------------------------------
; Zone EVERY block present except the base 'S' and the top beam 'T_B', selected by exclusion rather than by the
; 'Masonry' group (some cut pieces were missed by the group and left rigid, which crashed generate-subcontacts).
; The joists and their supports are created after this, so they stay rigid by construction.
[global ZONE_EDGE = 0.10]     ; m, tetrahedron edge length in the masonry
[global E_UNIT = 5.0e9]       ; Pa  PLACEHOLDER
[global NU_UNIT = 0.15]
block zone generate edgelength [ZONE_EDGE] range group "S" or "T_B" not
block group "Masonry" range group "S" or "T_B" not
; CHECK: every wall block must now carry zones; stop here (before any contact work) if one does not
fish define defss_rigid_check
    loop foreach local b block.list
        block.extra(b, 1) = 0
    endloop
    loop foreach local z block.zone.list
        block.extra(block.zone.hostblock(z), 1) = 1
    endloop
    local nm = 0
    local nr = 0
    loop foreach local b block.list
        if block.isgroup(b, 'S') = false then
            if block.isgroup(b, 'T_B') = false then
                nm = nm + 1
                if block.extra(b, 1) = 0 then
                    nr = nr + 1
                    if nr <= 20 then
                        io.out('DEFSS NOT zoned: block ' + string(block.id(b)) + ' at ' + string(block.pos(b)) + ', volume ' + string(block.vol(b)) + ' m3')
                    endif
                endif
            endif
        endif
    endloop
    io.out('DEFSS wall blocks ' + string(nm) + ', not zoned ' + string(nr) + ' (geometry: 442 masonry blocks)')
    if nr > 0 then
        system.error = 'DEFSS: ' + string(nr) + ' wall blocks were not zoned (listed above); stopping before the contacts'
    endif
    defss_rigid_check = nr
end
[defss_rigid_check]

block create brick 0.8882 0.9690 0.105 1.355 0.23455 0.41045 group 'Joist'
block create brick 0.8882 0.9690 0.105 1.355 2.11091 2.28682 group 'Joist'

block create brick 0.3230 0.4037 0.105 1.355 0.23455 0.41045 group 'Joist'
block create brick 0.3230 0.4037 0.105 1.355 2.11091 2.28682 group 'Joist'

; 3 meters long
block create brick 0 1.292 1 1.5 0.14137 0.23455 group 'Joist_S1'
block create brick 0 1.292 1 1.5 2.01773 2.11091 group 'Joist_S2'

; (masonry already zoned right after the geometry; its faces are the zone faces)
block face triangulate edge-max [0.05] range group "Masonry" not

;MATERIAL PROPERTIES
block property density 1885 range group "Masonry"
block zone cmodel assign elastic range group "Masonry"
block zone property density 1885 young [E_UNIT] poisson [NU_UNIT] range group "Masonry"
block property density 7850 range group "S" or "T_B" or "Joist_S1" or "Joist_S2"
block property density [5510*1.034] range group "Joist"

; mat_case.dat's property set, copied INLINE without its 'model large-strain on' (no switch to large strain at all)
fish define properties
    kn       = 2.5e9
    ks       = 2.5e9
    tension  = 0.0
    cohesion = 0.2e6
    friction = 36
    fc_comp  = 20e6
    Gt = 0.025*((2*tension*1e-6)^0.7)*1000
    Gs = 100
    Gc = (0.15+0.43*fc_comp*1e-6-0.0036*(fc_comp*1e-6)^2)*1000
    n   = 2.0
    Css = 9.0
    Cnn = 1.0
    Cn  = 0.0
end
@properties
; ---- f_t = 0.05 MPa, cohesion 0.2 MPa for every joint (overrides mat_case.dat; as the f_t sweep) ----
[global tension  = 0.05e6]
[global cohesion = 0.2e6]
[global Gt = 0.025*((2*tension*1e-6)^0.7)*1000]
[io.out('joints: tension ' + string(tension) + ' Pa, cohesion ' + string(cohesion) + ' Pa, G_I ' + string(Gt) + ' N/m')]
;CONTACT PROPERTIES
block contact generate-subcontacts
block contact jmodel assign mason_v12
block contact prop stiffness-normal @kn stiffness-initial @kn  stiffness-shear @ks ...
    tension @tension cohesion @cohesion friction @friction ...
    friction-residual @friction cohesion-residual [0.1*cohesion] ...
    G_I @Gt G_II @Gs G_c @Gc compression @fc_comp ...
    comp-residual [fc_comp*0.2] Cn [Cn] Cnn [Cnn] Css [Css] peak_ratio [n]

; ---- pK11 pocket: timber-mortar set on the joist-masonry contacts (Arslan et al. 2024) ----
block contact prop stiffness-shear 1.1e8 tension 0 cohesion 0.1e6 friction 31.0 ...
    friction-residual 31.0 cohesion-residual 0 ...
    range group-intersection 'Joist' 'Masonry'

;Timber Support Properties
block contact jmodel assign mohr range group-intersection 'Joist' 'Joist_S1'
block contact property stiffness-normal [kn*0.1] stiffness-shear 1 ...
    tension 1 cohesion 1 friction 1 ...
    range group-intersection 'Joist' 'Joist_S1'

block contact jmodel assign mohr range group-intersection 'Joist' 'Joist_S2'
block contact property stiffness-normal [kn*0.1] stiffness-shear 1 ...
    tension 1 cohesion 1 friction 1 ...
    range group-intersection 'Joist' 'Joist_S2'

block contact	material-table	default	jmodel mason_v12
block contact material-table default prop stiffness-normal @kn stiffness-initial @kn ...
    stiffness-shear @ks tension 0 cohesion 0 friction @friction ...
    friction-residual @friction cohesion-residual 0 G_I @Gt G_II @Gs ...
    G_c @Gc compression @fc_comp comp-residual [0] Cn [0] Cnn [1] Css [9] ...
    peak_ratio [3.0]

;BOUNDARY CONDITIONS
block fix range group 'S'
block fix range group 'Joist_S1'
block fix range group 'Joist_S2'

;HISTORIES
fish def Record_Disp
   monitoring_point = block.gp.near(0.644, 0.21, 2.68)
   monitoring_point_1 = block.gp.near(0.644, 0.21, 0.6)
   monitoring_point_2 = block.gp.near(0.644, 0.21, 1.26)
   monitoring_point_3a = block.gp.near(1.184, 0.21, 2.06)
   monitoring_point_3b = block.gp.near(0.104, 0.21, 2.06)
   Record_Disp = block.gp.disp.y(monitoring_point)
   Bot_Quarter_Disp = block.gp.disp.y(monitoring_point_1)
   Mid_Disp = block.gp.disp.y(monitoring_point_2)
   Top_Quarter_A_Disp = block.gp.disp.y(monitoring_point_3a)
   Top_Quarter_B_Disp = block.gp.disp.y(monitoring_point_3b)
end
fish history Record_Disp
fish history Bot_Quarter_Disp
fish history Mid_Disp
fish history Top_Quarter_A_Disp
fish history Top_Quarter_B_Disp
[Record_Disp]

block apply velocity-x 0 range group 'T_B' 
block apply velocity-y 0 range group 'T_B'   ; OOP (was velocity-z) 

block initialize rvelocity-z 0 range group 'T_B'   ; rotation about the vertical (was rvelocity-y)
block initialize rvelocity-y 0 range group 'T_B'   ; rotation about the OOP axis (was rvelocity-z)
block fix rotation-z range group 'T_B'   ; was rotation-y
block fix rotation-y range group 'T_B'   ; was rotation-z
block face group "Comp_apply" range pos-z 2.68
block hide off
; "Reaction" (default slot) = base + joist supports, as cstav has always used.
; The check groups live in their own slot so they do not overwrite "Reaction".
block contact group "Reaction" range pos-z -0.01 0.01 
block contact group "Reaction_base" slot "vcheck" range pos-z -0.01 0.01
block hide range group "Masonry" or "S" or "T_B"
block contact group "Reaction" range pos-x -1 1
block contact group "Reaction_joist" slot "vcheck" range pos-x -1 1
block hide off
; T_B-masonry contacts (top joint) and masonry-masonry contacts, for the pushover diagnostics
block contact group "Reaction_topTB" slot "vcheck" range group-intersection 'T_B' 'Masonry'
block hide range group 'Masonry' not
block contact group "MasJ" slot "vcheck" range position-x -1 2
block hide off

fish define contactList
    local allpts = list(block.contact.list) ; A list of pointers to scalars
    local check = block.contact.isgroup(::block.contact.list,'Reaction')     
    ; List of booleans
    contactList = allpts(check) ; List of scalars in 'surface'    
end
@contactList
fish define cstav
    contactList
    local scstav_vec = 0.0
    ncstav = 0.0
    ncjdisp = 0.0
    local scjdisp_vec = 0.0
    local jarea = 0.0
    negFlag = 0.0
    loop foreach cx contactList
        scx = block.contact.subcontactlist(cx)
        loop foreach sc scx
             ; weight by area
             local area_ = block.subcontact.area(sc)
             scstav_vec = scstav_vec + block.subcontact.force.shear.y(sc)   ; OOP
             ncstav = ncstav + block.subcontact.force.norm(sc)
             ncjdisp = ncjdisp + block.subcontact.disp.norm(sc)*area_
             scjdisp_vec = scjdisp_vec + block.subcontact.disp.shear.y(sc)*area_   ; OOP
             jarea = jarea + area_
        endloop
    endloop
    if jarea > 0 then
        ncstav = ncstav/jarea
        sstop = 0.0
        cstav = scstav_vec/1000
    endif        
end
@cstav
fish history cstav
fish history ncstav

; ----------------------------------------------------------------------
; VERTICAL-LOAD CHECK (forces, not stresses)
; ----------------------------------------------------------------------
[global spring_total = 10350.0]        ; N, both springs, group's sheet / Table 1
fish define sum_norm_group(gname, gslot)
    local f = 0.0
    loop foreach local cx block.contact.list
        if block.contact.isgroup(cx, gname, gslot)
            loop foreach local sc block.contact.subcontactlist(cx)
                f = f + block.subcontact.force.norm(sc)
            endloop
        endif
    endloop
    sum_norm_group = f
end
fish define mass_group(gname)
    local m = 0.0
    loop foreach local b block.list
        if block.isgroup(b, gname)
            m = m + block.mass(b)
        endif
    endloop
    mass_group = m
end
fish define applied_force_y_group(gname)
    local f = 0.0
    loop foreach local b block.list
        if block.isgroup(b, gname)
            f = f + comp.z(block.force.app(b))   ; vertical is z (function name kept)
        endif
    endloop
    applied_force_y_group = f
end
fish define check_vertical_loads
    local g0 = 9.81
    local m_mas = mass_group('Masonry')
    local m_joi = mass_group('Joist')
    local m_tb  = mass_group('T_B')
    local f_app = applied_force_y_group('T_B')          ; should be -spring_total
    local f_base  = sum_norm_group('Reaction_base',  'vcheck')
    local f_joist = sum_norm_group('Reaction_joist', 'vcheck')
    local f_all   = sum_norm_group('Reaction', 'Default')
    local w_total = g0 * (m_mas + m_joi + m_tb) - f_app  ; weight + applied downward force
    local joist_into_wall = g0 * m_joi - f_joist
    local f_base_exp = g0 * (m_mas + m_tb) - f_app + joist_into_wall
    io.out(' ')
    io.out('==== VERTICAL LOAD CHECK (forces in N) ====')
    io.out('masonry mass        = ' + string(m_mas) + ' kg   (sheet: 1340 kg)')
    io.out('joist mass (4 blk)  = ' + string(m_joi) + ' kg')
    io.out('T_B mass            = ' + string(m_tb)  + ' kg   [CHECK: steel only, ~213 kg]')
    io.out('applied force on T_B (vertical, z) = ' + string(f_app) + ' N   [CHECK: -' + string(spring_total) + ']')
    io.out('weight + applied, all free = ' + string(w_total))
    io.out('sum force.norm, Reaction (base+joist supports) = ' + string(f_all))
    if f_all > 0 then
        io.out('   -> (weight+applied) / Reaction sum         = ' + string(w_total / f_all) + '   [CHECK ~1.00]')
    else
        io.out('   -> Reaction group is EMPTY')
    endif
    io.out('sum force.norm, base contacts only             = ' + string(f_base))
    io.out('expected base force                            = ' + string(f_base_exp))
    if f_base_exp > 0 then
        io.out('   -> base / expected                          = ' + string(f_base / f_base_exp) + '   [CHECK ~1.00]')
    endif
    io.out('base stress = base force / (0.21*1.292)        = ' + string(f_base / (0.21*1.292) / 1e6) + ' MPa   [sheet: 0.1008; density build gave 0.096]')
    io.out('sum force.norm, joist supports                 = ' + string(f_joist))
    io.out('joist weight carried by the WALL               = ' + string(joist_into_wall / g0) + ' kg   [density build: 76 kg]')
    io.out('===========================================')
end
fish define nbase_stress
    local f = 0.0
    local a = 0.0
    loop foreach local cx block.contact.list
        if block.contact.isgroup(cx, 'Reaction_base', 'vcheck')
            loop foreach local sc block.contact.subcontactlist(cx)
                f = f + block.subcontact.force.norm(sc)
                a = a + block.subcontact.area(sc)
            endloop
        endif
    endloop
    nbase_stress = f / a
end
fish history nbase_stress
model large-strain off
model gravity 0 0 -9.81
model solve ratio 1e-6
[io.out('--- after gravity only (no spring force yet) ---')]
[check_vertical_loads]

; ----------------------------------------------------------------------
; SPRING PRECOMPRESSION AS AN APPLIED FORCE ON THE RIGID BEAM
; Global direction, acts at the centroid: no follower moment (the face
; traction failed in large strain for that reason) and no added mass
; (the equivalent density put ~1055 kg of inertia on the beam).
; ----------------------------------------------------------------------
fish define apply_spring_force
    loop foreach local b block.list
        if block.isgroup(b, 'T_B')
            block.force.app(b) = vector(0.0, 0.0, -spring_total)
        endif
    endloop
end
[apply_spring_force]
block property density 7850 range group 'T_B'
model solve ratio 5e-8
[io.out('--- after spring force, settled ---')]
[check_vertical_loads]

; ---- checks: zoning, zone mass, pocket set ----
fish define defss_report
    local nz = 0
    local mz = 0.0
    loop foreach local z block.zone.list
        if block.isgroup(block.zone.hostblock(z), 'Masonry') then
            nz = nz + 1
            mz = mz + block.zone.vol(z) * block.zone.density(z)
        endif
    endloop
    local npk = 0
    local kmin = 1e30
    local kmax = -1e30
    loop foreach local cx block.contact.list
        if block.contact.isgroup(cx, 'PocketJM', 'pocket') then
            loop foreach local sc block.contact.subcontactlist(cx)
                npk = npk + 1
                kmin = math.min(kmin, block.subcontact.prop(sc, 'stiffness-shear'))
                kmax = math.max(kmax, block.subcontact.prop(sc, 'stiffness-shear'))
            endloop
        endif
    endloop
    io.out('DEFSS masonry zones ' + string(nz) + ', zone mass ' + string(mz) + ' kg (rigid build: 1308.3 kg)')
    io.out('DEFSS pocket subcontacts ' + string(npk) + ', stiffness-shear ' + string(kmin) + '-' + string(kmax) + ' Pa/m (must be 1.1e8)')
    defss_report = nz
end
model save 'Part_I_MASON_v8_SmallStrain_springforce_zup_pk2_ft0p05_pK11_def'
; the report runs after the save, so a FISH name problem cannot cost the build
block contact group 'PocketJM' slot 'pocket' range group-intersection 'Joist' 'Masonry'
[defss_report]
;;call "sinus_wave_analysis.dat"