model new
model config dynamic 
model dynamic active off
model large-strain off

call 'Groningen.dec'

;SUPPORT BLOCK
block create brick 0 1.292 -0.05 0 0.0 0.210 group 'S'

;TOP BEAM
block create brick 0 1.292 2.58 2.68 0.0 0.210 group 'T_B'

block hide range pos-y -10000 0.2932
block hide range pos-y 0.4691 2.0523 
block hide range pos-y 2.2282 100000

block hide range pos-y 0.35 0.40
block hide range pos-y 2.10 2.16

block cut joint-set dip 0 dip-direction 0 origin 0 0 0.105

block hide

block hide off range pos-y 0.35 0.40
block hide off range pos-y 2.10 2.16

block hide pos-x 0 0.32
block hide pos-x 0.96 11
block hide pos-x 0.43 0.85
block cut joint-set dip 0 dip-direction 0 origin 0 0 0.105

block hide off

block hide range pos-y -10000 0.2932
block hide range pos-y 0.4691 2.0523 
block hide range pos-y 2.2282 100000

block hide range pos-z -1 0.105

block cut joint-set dip 90 dip-direction 90 origin 0.3230 0 0 
block cut joint-set dip 90 dip-direction 90 origin 0.4038 0 0 
block delete range pos-x 0.3230 0.4038

block cut joint-set dip 90 dip-direction 90 origin 0.8883 0 0 
block cut joint-set dip 90 dip-direction 90 origin 0.9690 0 0 
block delete range pos-x 0.8883 0.9690

block hide off
block group "Masonry" range group "S" or "T_B" not
model save 'GEO_WALL'
