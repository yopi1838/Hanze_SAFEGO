; instrument_history_new_zup.dat -- instrument_history_new.dat for the Z-UP frame (29 Oct 2026):
;   X = 1.292 - x (in-plane), Y = z (out-of-plane, +Y towards the joists), Z = y (vertical).
;   Every gridpoint position (x, y, z) -> (1.292 - x, z, y); OOP components .z -> .y; displacement-z /
;   velocity-z histories -> -y. Channel names, history indices and signs unchanged (+Y = +z of the old frame).
;   The left/right quarter points swap X (Ch3 'Left' old x = 0.106 -> X = 1.186), as Record_Disp in
;   ANALYSIS_PART_I_MASON_zup.dat. Calls instrument_tilt_v2_zup.dat.
;   3 Nov 2026: Channel_8..11 are now JOIST-TO-WALL SLIP in mm (see the block before Channel_12), not wall points.
[bLength=1.292]
history delete
;HISTORIES
fish def Record_Disp
   monitoring_point = block.gp.near(0.644, 0.21, 2.68)
   monitoring_point_1 = block.gp.near(0.644, 0.21, 0.6)
   monitoring_point_2 = block.gp.near(0.644, 0.21, 1.26)
   monitoring_point_3a = block.gp.near(1.184, 0.21, 2.06)
   monitoring_point_3b = block.gp.near(0.104, 0.21, 2.06)
   Record_Disp = block.gp.disp.y(monitoring_point)
   Bot_Quarter_Disp = block.gp.disp.y(monitoring_point_1)
   Mid_Disp = block.gp.disp.y(monitoring_point_2)
   Top_Quarter_A_Disp = block.gp.disp.y(monitoring_point_3a)
   Top_Quarter_B_Disp = block.gp.disp.y(monitoring_point_3b)
end

fish define contactList
    local allpts = list(block.contact.list) ; A list of pointers to scalars
    local check = block.contact.isgroup(::block.contact.list,'Reaction')   
    local j1list = list(block.contact.list)
    local j1check = block.contact.isgroup(::block.contact.list, 'Joist_S1_contact')
    j1 = j1list(j1check) 
    local j2list = list(block.contact.list)
    local j2check = block.contact.isgroup(::block.contact.list, 'Joist_S2_contact')
    j2 = j2list(j2check) 
    ; List of booleans
    contactList = allpts(check) ; List of scalars in 'surface'    
end
@contactList
; === Updated cstav with joist reactions and total shear ===
fish define cstav
    ; --- Base reaction (existing 'Reaction' group) ---
    contactList
    local scstav_vec = 0.0
    local jarea = 0.0
    total_shear = 0.0
    loop foreach cx contactList
        loop foreach sc block.contact.subcontactlist(cx)
            scstav_vec = scstav_vec + block.subcontact.force.shear.y(sc)   ; OOP
            jarea = jarea + block.subcontact.area(sc)
        endloop
    endloop
    cstav = scstav_vec / 1000  ; kN

    ; --- Joist_S1 reaction ---
    local fz_j1 = 0.0
    
    loop foreach cxf j1
        loop foreach sc block.contact.subcontactlist(cxf)
            fz_j1 = fz_j1 + block.subcontact.force.shear.y(sc)   ; OOP
        endloop
    endloop
    joist_s1_shear = fz_j1 / 1000  ; kN

    ; --- Joist_S2 reaction ---
    local fz_j2 = 0.0
    
    loop foreach cx j2
        loop foreach sc block.contact.subcontactlist(cx)
            fz_j2 = fz_j2 + block.subcontact.force.shear.y(sc)   ; OOP
        endloop
    endloop
    joist_s2_shear = fz_j2 / 1000  ; kN

    ; --- Total (comparable to experimental V = Σ m·a) ---
    total_shear = scstav_vec/1000 + fz_j1 / 1000 + fz_j2 / 1000
end
; =====================================================================
; TILT ANGLE COMPUTATION (via FISH)
; =====================================================================
; Tilt = arctan( (dz_upper - dz_lower) / dy )
; Reported in degrees. Positive = tilting in +z direction.
;
; Gridpoints are located along the wall centerline (x=bLength/2, z=0.21)
; at the same positions as the displacement channels.
;
; Segments:
;   tilt_bot_seg   : table (y=0.00) to bottom quarter (y=0.66)  dy=0.66
;   tilt_low_seg   : bottom quarter (y=0.66) to mid (y=1.26)    dy=0.60
;   tilt_up_seg    : mid (y=1.26) to top (y=2.06)               dy=0.80
;   tilt_beam_seg  : top wall (y=2.06) to beam (y=2.68)         dy=0.62
;   tilt_full_wall : table (y=0.00) to top wall (y=2.06)        dy=2.06
; =====================================================================

fish define tilt_angles
    ; Locate gridpoints (same as displacement channels)
    local gp_table  = block.gp.near(0.646, 0.21, 0.00)
    local gp_bot    = block.gp.near(0.646, 0.21, 0.66)
    local gp_mid    = block.gp.near(0.646, 0.21, 1.26)
    local gp_top    = block.gp.near(0.646, 0.21, 2.06)
    local gp_beam   = block.gp.near(0.646, 0.21, 2.68)

    ; Get out-of-plane displacements (Y-direction, z-up frame)
    local dz_table  = block.gp.disp.y(gp_table)
    local dz_bot    = block.gp.disp.y(gp_bot)
    local dz_mid    = block.gp.disp.y(gp_mid)
    local dz_top    = block.gp.disp.y(gp_top)
    local dz_beam   = block.gp.disp.y(gp_beam)

    ; Segment heights
    local dy_bot_seg  = 0.66
    local dy_low_seg  = 0.60
    local dy_up_seg   = 0.80
    local dy_beam_seg = 0.62
    local dy_full     = 2.06

    ; Tilt angles in degrees
    ; arctan( relative_dz / dy ) * 180/pi
    local rad2deg = 180.0 / math.pi

    tilt_bot_seg   = math.atan((dz_bot  - dz_table) / dy_bot_seg)  * rad2deg
    tilt_low_seg   = math.atan((dz_mid  - dz_bot)   / dy_low_seg)  * rad2deg
    tilt_up_seg    = math.atan((dz_top  - dz_mid)   / dy_up_seg)   * rad2deg
    tilt_beam_seg  = math.atan((dz_beam - dz_top)   / dy_beam_seg) * rad2deg
    tilt_full_wall = math.atan((dz_top  - dz_table) / dy_full)     * rad2deg
    tilt_angles = math.atan((dz_bot  - dz_table) / dy_bot_seg)  * rad2deg
    ; Relative displacement (Ch19 - Ch5) in mm for convenience
    rel_disp_top_mm = (dz_top - dz_table) * 1000.0
end

@tilt_angles
@cstav
fish history Record_Disp ;1
fish history Bot_Quarter_Disp ;2
fish history Mid_Disp ;3
fish history Top_Quarter_A_Disp ;4
fish history Top_Quarter_B_Disp ;5
fish history cstav ;6
fish history joist_s1_shear ;7
fish history joist_s2_shear ;8
fish history total_shear ;9
fish history tilt_angles ;10
fish history tilt_bot_seg ;11
fish history tilt_low_seg ;12
fish history tilt_up_seg ;13
fish history tilt_beam_seg ;14
fish history tilt_full_wall ;15
fish history rel_disp_top_mm ; 16

call 'instrument_tilt_v2_zup.dat'       

[Record_Disp]
; =====================================================================
; DISPLACEMENT CHANNELS
; =====================================================================
block history name "Channel_1_DispBot" displacement-y position ([bLength/2],0.21,0.66) 
block history name "Channel_2_DispMid" displacement-y position ([bLength/2],0.21,1.26)
block history name "Channel_3_DispTopQLeft" displacement-y position ([bLength/2+0.54],0.21,2.06)
block history name "Channel_4_DispTopQRight" displacement-y position ([bLength/2-0.54],0.21,2.06)
block history name "Channel_5_DispTable" displacement-y position ([bLength/2],0.21,0.0)
;
; ---------------------------------------------------------------------
; CHANNELS 8-11: JOIST-TO-WALL SLIP, as the test's potentiometers (changed 3 Nov 2026)
; ---------------------------------------------------------------------
; Test (Moshfeghi et al. 2024, Fig. 8): potentiometers 8/9 at the lower LEFT joist, 10/11 at the upper
; LEFT joist, below (8, 10) and above (9, 11) it, reading the joist's out-of-plane movement relative to
; the wall. US-1 run 24 leaves ch10 10.5 mm and ch11 11.8 mm of permanent slip (the paper's 8-12 mm).
; BEFORE this change the four histories below were WALL points at the old pocket heights
; (0.56 / 0.66 / 2.35 / 2.45 m, in m): Channel_8..11 files written before 3 Nov 2026 are NOT slip.
; DEFINITION (mm, revised 8 Nov 2026): slip = u_y(JOIST BLOCK) - u_y(wall, JS_OFF below / above the joist).
;   Joist side: block.disp.y of the left joist BLOCK (the average of its gridpoint displacements; for the rigid
;   joist its translation). The two left joists are found ONCE per call of this file, by group 'Joist', X centre
;   (jx_e1 + jx_e2)/2 and Z centre jy_lower / jy_upper, and kept as block IDs; every sample reads
;   block.disp.y(block.find(id)).
;   WHY: until 8 Nov the joist point was block.gp.near(edge, Y 0.255, z) at every sample. The joist faces are
;   triangulated (vertices ~0.05 m apart along Y), so once the joist had slid ~25 mm the nearest vertex became
;   the next one and the channel jumped by ~50 mm (pK11 Strategy F, runs 20-23: single-sample jumps of 45-1000 mm).
;   Wall side unchanged: front-face points (Y = JY_WALL = 0) averaged over X 0.8882 and 0.9690; the wall moves
;   along Y as a body there, so the nearest front-face vertex does not change.
;   +Y points to the joists: POSITIVE = joist withdrawing from its pocket (the paper's positive direction).
;   Channels 8 / 9 (and 10 / 11) share the joist term and differ in the wall point (below / above the joist).
; CUMULATIVE: displacements are not reset between runs; per-run slip = end - start of the run.
; ORDER: these come after FISH histories 1-31 (instrument_tilt_v2_zup.dat) and are exported BY NAME, so
;   no numbered export in instrument_history_export_v2.dat shifts. jy_lower / jy_upper (joist centres)
;   are read when the joists are looked up, so the driver's per-build override applies.
; 13 Nov 2026: the joists are looked up at their position BEFORE displacement (block.pos - block.disp), so a joist
;   that has moved more than 5 cm (a collapsing wall) is still found; one that is not found is reported and its
;   channels read 0 -- the lookup no longer stops the analysis (it stopped the T_p / T_p Route 2 run after a collapse).
[jh_half = 0.08795]    ; half joist height (0.1759 m)
[js_off  = 0.03]       ; wall reference distance below / above the joist
[jx_e1   = 0.8882]     ; left joist edges, X
[jx_e2   = 0.9690]
[jy_wall = 0.0]        ; Y of the wall reference points (front face)
[global jid_lower = 0]
[global jid_upper = 0]
fish define ch_joist_ids
    ; every local declared ONCE, at the top
    local b = null
    local p = null
    jid_lower = 0
    jid_upper = 0
    loop foreach b block.list
        if block.isgroup(b, 'Joist') then
            p = block.pos(b) - block.disp(b)          ; position BEFORE the displacement: found however far it has moved
            if math.abs(comp.x(p) - 0.5 * (jx_e1 + jx_e2)) < 0.02 then
                if math.abs(comp.z(p) - jy_lower) < 0.05 then
                    jid_lower = block.id(b)
                endif
                if math.abs(comp.z(p) - jy_upper) < 0.05 then
                    jid_upper = block.id(b)
                endif
            endif
        endif
    endloop
    io.out('joist slip channels: left joists, block ' + string(jid_lower) + ' (lower) and ' + string(jid_upper) + ' (upper)')
    if jid_lower = 0 then
        io.out('  ** joist slip channels: lower left joist NOT found -- channels 8 / 9 read 0, the analysis goes on')
    endif
    if jid_upper = 0 then
        io.out('  ** joist slip channels: upper left joist NOT found -- channels 10 / 11 read 0, the analysis goes on')
    endif
    ch_joist_ids = jid_upper
end
fish define ch_joist_slip
    ; every local declared ONCE, at the top
    local zlb = jy_lower - jh_half
    local zlt = jy_lower + jh_half
    local zub = jy_upper - jh_half
    local zut = jy_upper + jh_half
    local jl = 0.0
    local ju = 0.0
    local wlb = 0.5 * (block.gp.disp.y(block.gp.near(jx_e1, jy_wall, zlb - js_off)) + block.gp.disp.y(block.gp.near(jx_e2, jy_wall, zlb - js_off)))
    local wlt = 0.5 * (block.gp.disp.y(block.gp.near(jx_e1, jy_wall, zlt + js_off)) + block.gp.disp.y(block.gp.near(jx_e2, jy_wall, zlt + js_off)))
    local wub = 0.5 * (block.gp.disp.y(block.gp.near(jx_e1, jy_wall, zub - js_off)) + block.gp.disp.y(block.gp.near(jx_e2, jy_wall, zub - js_off)))
    local wut = 0.5 * (block.gp.disp.y(block.gp.near(jx_e1, jy_wall, zut + js_off)) + block.gp.disp.y(block.gp.near(jx_e2, jy_wall, zut + js_off)))
    ch8_slip  = 0.0
    ch9_slip  = 0.0
    ch10_slip = 0.0
    ch11_slip = 0.0
    if jid_lower # 0 then
        jl = block.disp.y(block.find(jid_lower))
        ch8_slip  = (jl - wlb) * 1000.0
        ch9_slip  = (jl - wlt) * 1000.0
    endif
    if jid_upper # 0 then
        ju = block.disp.y(block.find(jid_upper))
        ch10_slip = (ju - wub) * 1000.0
        ch11_slip = (ju - wut) * 1000.0
    endif
    ch_joist_slip = ch11_slip
end
@ch_joist_ids
@ch_joist_slip
fish history ch_joist_slip
fish history name "Channel_8_LeftJoistBelowSlab1" ch8_slip
fish history name "Channel_9_LeftJoistAboveSlab1" ch9_slip
fish history name "Channel_10_LeftJoistBelowSlab2" ch10_slip
fish history name "Channel_11_LeftJoistBelowSlab2" ch11_slip
; (Channel_11 keeps its old, mistyped name so the export file needs no change: it is ABOVE the upper joist)
; ---------------------------------------------------------------------

; =====================================================================
; VELOCITY CHANNELS (for acceleration derivation)
; =====================================================================
block history name "Channel_12_AccTable" velocity-y position ([bLength/2],0.21,0.0) 
block history name "Channel_13_AccSlab1" velocity-y position ([bLength/2],0.73,0.49) 
block history name "Channel_14_AccSlab2" velocity-y position ([bLength/2],0.73,2.28) 
block history name "Channel_15_AccBot" velocity-y position ([bLength/2],0.21,0.66) 
block history name "Channel_16_AccMid" velocity-y position ([bLength/2],0.21,1.26) 
block history name "Channel_17_AccTop" velocity-y position ([bLength/2],0.21,2.06) 
block history name "Channel_19_DispTopQRight" displacement-y position ([bLength/2],0.21,2.06)
block history name "Channel_20_TopBeam" displacement-y position ([bLength/2],0.21,2.68) 
model history name "time" dynamic time-total


