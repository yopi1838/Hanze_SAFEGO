# ---------------------------------------------------------------------------
# Hanze_SAFEGO - what git does NOT carry
#
# The full working folder is ~10 GB. Everything excluded here is either a
# regenerable 3DEC state file, a raw simulation output, or machine-specific.
# See CLAUDE.md section 9 for how to move the heavy data across.
# ---------------------------------------------------------------------------

# 3DEC saved states -- 44 MB (Part_I_MASON*) to 101 MB (stratC_run_*) each
*.sav
*.3dsav
*.sav.bak

# 3DEC project / scratch files -- machine-specific, regenerated by 3DEC
P.prj
P.temp
P.backup
*.prj
*.temp
*.backup

# Raw per-channel history exports: ~23 CSVs x ~2.5 MB per run x 25 runs x 5 variants
stratC_results_*/Run[0-9][0-9]_*/
!stratC_results_NODAMP_v7/Run[0-9][0-9]_*/
!stratC_results_GI_NORATCH/Run[0-9][0-9]_*/

# 3DEC bitmap dumps -- regenerate with export_plots.py
stratC_results_*/plots/

# CPU/memory monitor logs from monitor_3dec_cpu.sh
cpu_monitor_*.csv

# Presentation figure output (regenerate with make_presentation_figs.py)
presentation_figs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp

# ---------------------------------------------------------------------------
# Explicitly KEPT (listed for clarity; nothing above matches them):
#   *.py *.dat *.dec *.sh *.so *.md
#   spectrum_*.csv  cpu_3runs.csv
#   stratC_results_*/strategy_C_summary.csv
#   stratC_results_*/strategy_C_log.csv
#   stratC_results_*/stratC_checkpoint.json
#   stratC_results_*/vel_run_*.txt
#   stratC_results_*/postproc/**
# ---------------------------------------------------------------------------

# Staged-script intermediate JSON (safego_paths.cache_dir)
.cache/
