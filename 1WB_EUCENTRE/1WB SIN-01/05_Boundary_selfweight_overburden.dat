;;; Define boundary conditions
block gridpoint apply vel-x 0 range group "foundation"
block gridpoint apply vel-y 0 range group "foundation"
block gridpoint apply vel-z 0 range group "foundation"
block gridpoint apply vel-x 0 range group "steel beam"
block gridpoint apply vel-y 0 range group "steel beam"

;;; Define histories for vertical load monitoring
fish history @norm_bedjoint_B
history rename "norm_bedjoint_B" name "1"
fish history @shear_bedjoint_B
history rename "shear_bedjoint_B" name "2"
fish history @norm_bedjoint_T
history rename "norm_bedjoint_T" name "3"
fish history @shear_bedjoint_T
history rename "shear_bedjoint_T" name "4"
fish history @shearforce
history rename "shearforce" name "5"

;;; Joint force calculation callback (skipped steps = interval)
fish callback add joint_force 0.1 interval 1000

;;; Apply gravity loads
model update-interval 1000
model dynamic active off
block mech damping global 1.0
model gravity 0 0 -9.81
model solve 

model save 'SAV/precomp_applied.sav'