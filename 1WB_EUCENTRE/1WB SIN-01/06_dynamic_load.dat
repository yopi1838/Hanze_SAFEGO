model restore 'SAV/precomp_applied.sav'
model dynamic active
block gridpoint initialize velocity 0 0 0 
block gridpoint initialize displacement 0 0 0 
model cyc 1

;;; Monitor and apply density scaling
fish def dsfvspare
    loop foreach b block.list
        ig = block.gplist(b)
        loop foreach gp ig
            block.gp.extra(gp) = block.gp.dsf(gp)
        endloop
    endloop
end
@dsfvspare
fish callback add dsfvspare 50 interval 1000
;block mechanical mass-scale on timestep 7e-6 ; Set desired timestep and apply density scaling

;;; Apply Maxwell damping
block mech damp maxwell 0.0233 0.9970 0.0195 7.1172 0.0278 50.0027 ;;; 3% Maxwell (1-50Hz)

;;; Test density scaling applied (Gp Extra 1)
model update-interval 100
model cycle 1
model cycle 100

fish def check_state
    current_time = time.kernel/(3600*1000)
    time_total = dynamic.time.total
    current_step = mech.cycle
    io.out(string.build("Current state: elapsed time: %1, Dynamic time: %2, Cycle: %3",current_time,time_total,current_step))
end
@check_state
fish callback add check_state 52 interval 5000
model save "SAV/SinleLeaf_onerun_ready.sav"

