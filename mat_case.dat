; =====================================================================
; mat_case.dat  --  CASE G00 : LARGE-STRAIN GEOMETRY
; =====================================================================
; Purpose. Test whether the model can accumulate residual tilt at all.
; US-1 reaches roughly 6 degrees of cumulative tilt by Run 24 and 29.5 mm
; of out-of-plane displacement. Every run so far has produced 0.03 degrees
; and about 5 mm, with the amplification EDP/Sd_target pinned near 1.
;
; In small-strain mode 3DEC does not update block positions and does not
; re-detect contacts. Toe contact area therefore cannot reduce and the
; restoring action never becomes geometric, so there is no P-Delta term and
; no negative incremental stiffness. A wall in that mode has no mechanism
; for the superlinear growth the experiment shows, and a permanent lean
; cannot exist in the contact configuration.
;
; MATERIAL IS DELIBERATELY UNCHANGED from the NODAMP_v7_NEW run, including
; the mis-transcribed Gc expression, so that geometry mode is the only
; material-side difference between the two. Do not "fix" the values here.
; The corrected set lives in mat_case_baseline.dat and belongs to case 00.
; =====================================================================
fish define properties
    kn       = 2.5e9
    ks       = 2.5e9
    tension  = 0.344e6
    cohesion = 0.750e6
    friction = 36
    fc_comp  = 20e6
    Gt = 0.025*((2*tension*1e-6)^0.7)*1000
    Gs = 10.0 * Gt
    Gc = (0.15+0.43*fc_comp*1e-6-0.0036*(fc_comp*1e-6)^2)*1000
    n   = 2.0
    Css = 9.0
    Cnn = 1.0
    Cn  = 0.0
end
@properties

; ---------------------------------------------------------------------
; THE ONE CHANGE. Costs solve time and requires contact re-detection.
; ---------------------------------------------------------------------
model large-strain off