; =====================================================================
; ANALYSIS_PART_I_MASON_hingeft0_unclamp.dat -- the forced-hinge build (ANALYSIS_PART_I_MASON_hingeft0.dat, header
; below) with UNCLAMPED joist pockets: the contacts on the joists' top faces are made very soft (kn_top_factor = 1e-3),
; so the joists no longer carry the wall's weight and the pocket friction (36 deg, unchanged) acts on the joists' own
; reaction (~3 kN) instead of a ~44 kN clamp. Optional timber supports (fric_support / ks_support, off by default).
; Large strain, spring force, hinges at the base / 2.110 m / top, 0.344 MPa elsewhere: as the hinge build.
; Output: Part_I_MASON_v8_LargeStrain_springforce_hingeft0_unclamp.sav   (POCKET CHECK printed before the save)
; =====================================================================
; =====================================================================
; ANALYSIS_PART_I_MASON_hingeft0.dat -- the v8 large-strain spring-force build (ANALYSIS_PART_I_MASON.dat) with
;   * the characterisation joint properties everywhere:  tension 0.344 MPa, cohesion 0.75 MPa
;     (G_I from the same Gt expression as mat_case.dat, cohesion-residual 0.1 c)
;   * the f_t = 0 joint ONLY at the three hinges:          tension 0, G_I 0, cohesion 0.2 MPa, residual 0.02 MPa
;       base joint           pos-y -0.01  ... 0.01
;       ONE bed joint        pos-y  2.105 ... 2.115  (the 2.110 m joint, the one that opened most in the f_t = 0
;                                                     push; the rigid model's hinge h1 = 2.11 m)
;       top joint            pos-y  2.57  ... 2.59   (masonry - top beam)
;     and in both joist pockets (Joist - Masonry), as in the f_t = 0 build: the upper joist (2.052-2.228 m) spans
;     the 2.110 m joint, so a bonded pocket would tie the two blocks together through the joist.
;   Alternative (commented out below): the whole upper-floor course 2.03-2.25 m instead of the one joint.
; Everything else (geometry, joists, stiffness, supports, loads, histories) is ANALYSIS_PART_I_MASON.dat unchanged.
; mat_case.dat is called as before and NOT edited: the two strengths are overridden right after it.
; The hinges are set before the joist-support block, so the Joist - Joist_S2 contact (y 2.052, inside the upper
; course) gets its Mohr properties back from the lines that follow, exactly as in the original build.
; FISH 'tension' holds 0.344e6 in this save (the pushover guard: TENSION_MAX_PA >= 0.35e6).
; New contacts formed later use the material table (tension 0, cohesion 0), as before.
; Output: Part_I_MASON_v8_LargeStrain_springforce_hingeft0.sav
; =====================================================================
model new 
model restore 'GEO_WALL'

block create brick 0.3230 0.4038 0.29318 0.46909 0.105 1.355 group 'Joist'
block create brick 0.3230 0.4038 2.05227 2.22818 0.105 1.355 group 'Joist'

block create brick 0.8883 0.9690 0.29318 0.46909 0.105 1.355 group 'Joist'
block create brick 0.8883 0.9690 2.05227 2.22818 0.105 1.355 group 'Joist'

; 3 meters long
block create brick 0 1.292 0.20000 0.29318 1 1.5 group 'Joist_S1'
block create brick 0 1.292 1.95909 2.05227 1 1.5 group 'Joist_S2'

block face triangulate radial-8 range group "Masonry"
block face triangulate edge-max [0.05] range group "Masonry" not

;MATERIAL PROPERTIES
block property density 1885 range group "Masonry"
block property density 7850 range group "S" or "T_B" or "Joist_S1" or "Joist_S2"
block property density [5510*1.034] range group "Joist"

call 'mat_case.dat'
; ---- characterisation-based strengths for every joint (overrides mat_case.dat) ----
[global tension  = 0.344e6]
[global cohesion = 0.75e6]
[global Gt = 0.025*((2*tension*1e-6)^0.7)*1000]
; ---- the f_t = 0 joint for the hinge strips (the f_t = 0 build's values) ----
[global hinge_tension  = 0.0]
[global hinge_cohesion = 0.2e6]
[global hinge_Gt       = 0.0]
[io.out('joints: tension ' + string(tension) + ' Pa, cohesion ' + string(cohesion) + ' Pa, G_I ' + string(Gt) + ' N/m; hinge strips: tension ' + string(hinge_tension) + ', cohesion ' + string(hinge_cohesion))]
;CONTACT PROPERTIES
block contact generate-subcontacts
block contact jmodel assign mason_v12
block contact prop stiffness-normal @kn stiffness-initial @kn  stiffness-shear @ks ...
    tension @tension cohesion @cohesion friction @friction ...
    friction-residual @friction cohesion-residual [0.1*cohesion] ...
    G_I @Gt G_II @Gs G_c @Gc compression @fc_comp ...
    comp-residual [fc_comp*0.2] Cn [Cn] Cnn [Cnn] Css [Css] peak_ratio [n]

;HINGE STRIPS: f_t = 0 joint only where the wall hinges (before the supports, see the header)
block contact prop tension @hinge_tension G_I @hinge_Gt cohesion @hinge_cohesion cohesion-residual [0.1*hinge_cohesion] range pos-y -0.01 0.01
block contact prop tension @hinge_tension G_I @hinge_Gt cohesion @hinge_cohesion cohesion-residual [0.1*hinge_cohesion] range pos-y 2.105 2.115
;block contact prop tension @hinge_tension G_I @hinge_Gt cohesion @hinge_cohesion cohesion-residual [0.1*hinge_cohesion] range pos-y 2.03 2.25
block contact prop tension @hinge_tension G_I @hinge_Gt cohesion @hinge_cohesion cohesion-residual [0.1*hinge_cohesion] range group-intersection 'Joist' 'Masonry'
block contact prop tension @hinge_tension G_I @hinge_Gt cohesion @hinge_cohesion cohesion-residual [0.1*hinge_cohesion] range pos-y 2.57 2.59
block contact group 'HingeFT0' slot 'hingeft0' range pos-y -0.01 0.01
block contact group 'HingeFT0' slot 'hingeft0' range pos-y 2.105 2.115
;block contact group 'HingeFT0' slot 'hingeft0' range pos-y 2.03 2.25
block contact group 'HingeFT0' slot 'hingeft0' range group-intersection 'Joist' 'Masonry'
block contact group 'HingeFT0' slot 'hingeft0' range pos-y 2.57 2.59
block contact group 'none' slot 'hingeft0' range group-intersection 'Joist' 'Joist_S1'
block contact group 'none' slot 'hingeft0' range group-intersection 'Joist' 'Joist_S2'

;Timber Support Properties
; fric_support / ks_support = 1 / 1 keeps the build's near-frictionless supports (the joists can slide on them, so they
; do not strut the wall). Timber supports instead: fric_support 30, ks_support [kn*0.1] -- then the joists push back on
; the wall when it moves towards them (positive push) up to mu x support reaction, and that slip dissipates too.
[global fric_support = 1.0]
[global ks_support   = 1.0]
block contact jmodel assign mohr range group-intersection 'Joist' 'Joist_S1'
block contact property stiffness-normal [kn*0.1] stiffness-shear @ks_support ...
    tension 1 cohesion 1 friction @fric_support ...
    range group-intersection 'Joist' 'Joist_S1'

block contact jmodel assign mohr range group-intersection 'Joist' 'Joist_S2'
block contact property stiffness-normal [kn*0.1] stiffness-shear @ks_support ...
    tension 1 cohesion 1 friction @fric_support ...
    range group-intersection 'Joist' 'Joist_S2'

;JOIST POCKETS UNCLAMPED: the masonry resting on each joist's TOP face (y 0.469 m lower floor, 2.228 m upper floor)
; gets a very soft contact (kn_top_factor x kn, ks), so the wall's weight goes down through the masonry beside the
; pocket instead of through the rigid joist block (which carried ~75 % of it, a 44 kN clamp at the lower pocket).
; Bottom faces (the joist's own bearing) and side faces keep the hinge build's joint (f_t = 0, 36 deg friction).
[global kn_top_factor = 1.0e-3]
block contact jmodel assign mohr range group-intersection 'Joist' 'Masonry' pos-y 0.464 0.474
block contact property stiffness-normal [kn*kn_top_factor] stiffness-shear [ks*kn_top_factor] ...
    friction @friction cohesion 0 tension 0 range group-intersection 'Joist' 'Masonry' pos-y 0.464 0.474
block contact jmodel assign mohr range group-intersection 'Joist' 'Masonry' pos-y 2.223 2.233
block contact property stiffness-normal [kn*kn_top_factor] stiffness-shear [ks*kn_top_factor] ...
    friction @friction cohesion 0 tension 0 range group-intersection 'Joist' 'Masonry' pos-y 2.223 2.233
block contact group 'PocketTop' slot 'ptop' range group-intersection 'Joist' 'Masonry' pos-y 0.464 0.474
block contact group 'PocketTop' slot 'ptop' range group-intersection 'Joist' 'Masonry' pos-y 2.223 2.233
block contact group 'Pocket' slot 'pall' range group-intersection 'Joist' 'Masonry'

block contact	material-table	default	jmodel mason_v12
block contact material-table default prop stiffness-normal @kn stiffness-initial @kn ...
    stiffness-shear @ks tension 0 cohesion 0 friction @friction ...
    friction-residual @friction cohesion-residual 0 G_I @Gt G_II @Gs ...
    G_c @Gc compression @fc_comp comp-residual [0] Cn [0] Cnn [1] Css [9] ...
    peak_ratio [3.0]
; new contacts on the joists' top faces (large-strain updates) are soft too, not the default entry above
block contact material-table add jmodel mohr property stiffness-normal [kn*kn_top_factor] stiffness-shear [ks*kn_top_factor] ...
    friction [friction] cohesion 0 tension 0 range group-intersection 'Joist' 'Masonry' pos-y 0.464 0.474
block contact material-table add jmodel mohr property stiffness-normal [kn*kn_top_factor] stiffness-shear [ks*kn_top_factor] ...
    friction [friction] cohesion 0 tension 0 range group-intersection 'Joist' 'Masonry' pos-y 2.223 2.233

;BOUNDARY CONDITIONS
block fix range group 'S'
block fix range group 'Joist_S1'
block fix range group 'Joist_S2'

;HISTORIES
fish def Record_Disp
   monitoring_point = block.gp.near(0.648, 2.68, 0.21)
   monitoring_point_1 = block.gp.near(0.648, 0.6, 0.21)
   monitoring_point_2 = block.gp.near(0.648, 1.26, 0.21)
   monitoring_point_3a = block.gp.near(0.108, 2.06, 0.21)
   monitoring_point_3b = block.gp.near(1.188, 2.06, 0.21)
   Record_Disp = block.gp.disp.z(monitoring_point)
   Bot_Quarter_Disp = block.gp.disp.z(monitoring_point_1)
   Mid_Disp = block.gp.disp.z(monitoring_point_2)
   Top_Quarter_A_Disp = block.gp.disp.z(monitoring_point_3a)
   Top_Quarter_B_Disp = block.gp.disp.z(monitoring_point_3b)
end
fish history Record_Disp
fish history Bot_Quarter_Disp
fish history Mid_Disp
fish history Top_Quarter_A_Disp
fish history Top_Quarter_B_Disp
[Record_Disp]

block apply velocity-x 0 range group 'T_B' 
block apply velocity-z 0 range group 'T_B' 

block initialize rvelocity-y 0 range group 'T_B' 
block initialize rvelocity-z 0 range group 'T_B' 
block fix rotation-y range group 'T_B' 
block fix rotation-z range group 'T_B' 
block face group "Comp_apply" range pos-y 2.68
block hide off
; "Reaction" (default slot) = base + joist supports, as cstav has always used.
; The check groups live in their own slot so they do not overwrite "Reaction".
block contact group "Reaction" range pos-y -0.01 0.01 
block contact group "Reaction_base" slot "vcheck" range pos-y -0.01 0.01
block hide range group "Masonry" or "S" or "T_B"
block contact group "Reaction" range pos-x -1 1
block contact group "Reaction_joist" slot "vcheck" range pos-x -1 1
block hide off
; T_B-masonry contacts (top joint) and masonry-masonry contacts, for the pushover diagnostics
block contact group "Reaction_topTB" slot "vcheck" range group-intersection 'T_B' 'Masonry'
block hide range group 'Masonry' not
block contact group "MasJ" slot "vcheck" range position-x -1 2
block hide off

fish define contactList
    local allpts = list(block.contact.list) ; A list of pointers to scalars
    local check = block.contact.isgroup(::block.contact.list,'Reaction')     
    ; List of booleans
    contactList = allpts(check) ; List of scalars in 'surface'    
end
@contactList
fish define cstav
    contactList
    local scstav_vec = 0.0
    ncstav = 0.0
    ncjdisp = 0.0
    local scjdisp_vec = 0.0
    local jarea = 0.0
    negFlag = 0.0
    loop foreach cx contactList
        scx = block.contact.subcontactlist(cx)
        loop foreach sc scx
             ; weight by area
             local area_ = block.subcontact.area(sc)
             scstav_vec = scstav_vec + block.subcontact.force.shear.z(sc)
             ncstav = ncstav + block.subcontact.force.norm(sc)
             ncjdisp = ncjdisp + block.subcontact.disp.norm(sc)*area_
             scjdisp_vec = scjdisp_vec + block.subcontact.disp.shear.z(sc)*area_
             jarea = jarea + area_
        endloop
    endloop
    if jarea > 0 then
        ncstav = ncstav/jarea
        sstop = 0.0
        cstav = scstav_vec/1000
    endif        
end
@cstav
fish history cstav
fish history ncstav

; ----------------------------------------------------------------------
; VERTICAL-LOAD CHECK (forces, not stresses)
; ----------------------------------------------------------------------
[global spring_total = 10350.0]        ; N, both springs, group's sheet / Table 1
fish define sum_norm_group(gname, gslot)
    local f = 0.0
    loop foreach local cx block.contact.list
        if block.contact.isgroup(cx, gname, gslot)
            loop foreach local sc block.contact.subcontactlist(cx)
                f = f + block.subcontact.force.norm(sc)
            endloop
        endif
    endloop
    sum_norm_group = f
end
fish define mass_group(gname)
    local m = 0.0
    loop foreach local b block.list
        if block.isgroup(b, gname)
            m = m + block.mass(b)
        endif
    endloop
    mass_group = m
end
fish define applied_force_y_group(gname)
    local f = 0.0
    loop foreach local b block.list
        if block.isgroup(b, gname)
            f = f + comp.y(block.force.app(b))
        endif
    endloop
    applied_force_y_group = f
end
fish define check_vertical_loads
    local g0 = 9.81
    local m_mas = mass_group('Masonry')
    local m_joi = mass_group('Joist')
    local m_tb  = mass_group('T_B')
    local f_app = applied_force_y_group('T_B')          ; should be -spring_total
    local f_base  = sum_norm_group('Reaction_base',  'vcheck')
    local f_joist = sum_norm_group('Reaction_joist', 'vcheck')
    local f_all   = sum_norm_group('Reaction', 'Default')
    local w_total = g0 * (m_mas + m_joi + m_tb) - f_app  ; weight + applied downward force
    local joist_into_wall = g0 * m_joi - f_joist
    local f_base_exp = g0 * (m_mas + m_tb) - f_app + joist_into_wall
    io.out(' ')
    io.out('==== VERTICAL LOAD CHECK (forces in N) ====')
    io.out('masonry mass        = ' + string(m_mas) + ' kg   (sheet: 1340 kg)')
    io.out('joist mass (4 blk)  = ' + string(m_joi) + ' kg')
    io.out('T_B mass            = ' + string(m_tb)  + ' kg   [CHECK: steel only, ~213 kg]')
    io.out('applied force on T_B (y) = ' + string(f_app) + ' N   [CHECK: -' + string(spring_total) + ']')
    io.out('weight + applied, all free = ' + string(w_total))
    io.out('sum force.norm, Reaction (base+joist supports) = ' + string(f_all))
    if f_all > 0 then
        io.out('   -> (weight+applied) / Reaction sum         = ' + string(w_total / f_all) + '   [CHECK ~1.00]')
    else
        io.out('   -> Reaction group is EMPTY')
    endif
    io.out('sum force.norm, base contacts only             = ' + string(f_base))
    io.out('expected base force                            = ' + string(f_base_exp))
    if f_base_exp > 0 then
        io.out('   -> base / expected                          = ' + string(f_base / f_base_exp) + '   [CHECK ~1.00]')
    endif
    io.out('base stress = base force / (0.21*1.292)        = ' + string(f_base / (0.21*1.292) / 1e6) + ' MPa   [sheet: 0.1008; density build gave 0.096]')
    io.out('sum force.norm, joist supports                 = ' + string(f_joist))
    io.out('joist weight carried by the WALL               = ' + string(joist_into_wall / g0) + ' kg   [density build: 76 kg]')
    io.out('===========================================')
end
fish define nbase_stress
    local f = 0.0
    local a = 0.0
    loop foreach local cx block.contact.list
        if block.contact.isgroup(cx, 'Reaction_base', 'vcheck')
            loop foreach local sc block.contact.subcontactlist(cx)
                f = f + block.subcontact.force.norm(sc)
                a = a + block.subcontact.area(sc)
            endloop
        endif
    endloop
    nbase_stress = f / a
end
fish history nbase_stress
model large-strain on
model gravity 0 -9.81 0
model solve ratio 1e-6
[io.out('--- after gravity only (no spring force yet) ---')]
[check_vertical_loads]

; ----------------------------------------------------------------------
; SPRING PRECOMPRESSION AS AN APPLIED FORCE ON THE RIGID BEAM
; Global direction, acts at the centroid: no follower moment (the face
; traction failed in large strain for that reason) and no added mass
; (the equivalent density put ~1055 kg of inertia on the beam).
; ----------------------------------------------------------------------
fish define apply_spring_force
    loop foreach local b block.list
        if block.isgroup(b, 'T_B')
            block.force.app(b) = vector(0.0, -spring_total, 0.0)
        endif
    endloop
end
[apply_spring_force]
block property density 7850 range group 'T_B'
model solve ratio 5e-8
[io.out('--- after spring force, settled ---')]
[check_vertical_loads]

; ---- POCKET CHECK: what the joists carry now (top faces should be ~0; all pockets ~ the joists' own weight) ----
fish define pocket_load(gname, gslot)
    local f = 0.0
    local n = 0
    loop foreach local cx block.contact.list
        if block.contact.isgroup(cx, gname, gslot)
            loop foreach local sc block.contact.subcontactlist(cx)
                f = f + block.subcontact.force.norm(sc)
                n = n + 1
            endloop
        endif
    endloop
    io.out('  ' + gname + ': ' + string(n) + ' subcontacts, sum normal force ' + string(f) + ' N')
end
[io.out('==== POCKET CHECK (hinge build had ~44 kN in the lower pocket, ~75 % of the wall load there) ====')]
[pocket_load('PocketTop', 'ptop')]
[pocket_load('Pocket', 'pall')]
[pocket_load('Reaction_joist', 'vcheck')]
[io.out('=============================================================================================')]

model save 'Part_I_MASON_v8_LargeStrain_springforce_hingeft0_unclamp'
;;call "sinus_wave_analysis.dat"